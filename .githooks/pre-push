#!/bin/sh
# Buzz Bingo safety lock: refuse direct pushes (and branch deletes) on protected branches.
# Work on a branch and open a pull request instead. See docs/RELEASING.md.
# Turn on once per clone:  git config core.hooksPath .githooks
# Protected branches: edit the PROTECTED line below if this repo's default branch has another name.
PROTECTED="main develop master"

stop=0
while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  [ "$branch" = "$remote_ref" ] && continue   # tags and other refs are not checked
  for p in $PROTECTED; do
    if [ "$branch" = "$p" ]; then
      printf '%s\n' "Blocked: direct push to '$branch'. Push a feature branch and open a pull request instead." >&2
      stop=1
    fi
  done
done

if [ "$stop" = 1 ]; then
  printf '%s\n' "Rules: docs/RELEASING.md. Only Jana may override this, and only in the current chat." >&2
  exit 1
fi
exit 0
